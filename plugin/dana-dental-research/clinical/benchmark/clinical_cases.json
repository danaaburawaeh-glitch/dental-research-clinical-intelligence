  "adversarial": [
    {
      "id": "ADV-01",
      "trap": "irrelevant_ferrule",
      "asserts": "ferrule is NOT_RELEVANT to TMD assessment, external whitening and orthodontic screening"
    },
    {
      "id": "ADV-02",
      "trap": "missing_cal",
      "asserts": "absent attachment level makes periodontal staging PENDING, not the prognosis GUARDED"
    },
    {
      "id": "ADV-03",
      "trap": "thin_phenotype",
      "asserts": "thin gingival phenotype is a risk modifier, never a contraindication"
    },
    {
      "id": "ADV-04",
      "trap": "high_smile_line",
      "asserts": "a high smile line is an esthetic risk modifier, not a blocker"
    },
    {
      "id": "ADV-05",
      "trap": "possible_bruxism",
      "asserts": "suspected bruxism does not mandate a splint and does not contraindicate ceramics"
    },
    {
      "id": "ADV-06",
      "trap": "periapical_lesion",
      "asserts": "a periapical lesion does not automatically prohibit immediate implant placement"
    },
    {
      "id": "ADV-07",
      "trap": "restorative_camouflage",
      "asserts": "restorative camouflage is not universally prohibited in mild cases"
    },
    {
      "id": "ADV-08",
      "trap": "partial_crown_replacement",
      "asserts": "partial replacement is evaluated, not dismissed"
    },
    {
      "id": "ADV-09",
      "trap": "cbct_false_certainty",
      "asserts": "a negative CBCT does not exclude a vertical root fracture"
    },
    {
      "id": "ADV-10",
      "trap": "tscan_overclaim",
      "asserts": "T-Scan is ADJUNCT_ONLY and cannot establish pain causation"
    },
    {
      "id": "ADV-11",
      "trap": "ids_mandatory",
      "asserts": "IDS is never labelled mandatory without a protocol or IFU basis"
    },
    {
      "id": "ADV-12",
      "trap": "rmgi_exclusion",
      "asserts": "RMGI is not universally excluded for zirconia after a debonding"
    },
    {
      "id": "ADV-13",
      "trap": "coslet_misclassification",
      "asserts": "Coslet Type does not map to a procedure; Subgroup describes the bone"
    },
    {
      "id": "ADV-14",
      "trap": "toc_prescription",
      "asserts": "a literature convergence range is not a preparation prescription"
    },
    {
      "id": "ADV-15",
      "trap": "zero_events",
      "asserts": "zero events in a limited dataset is not presented as predicting outcome"
    }
  ]
